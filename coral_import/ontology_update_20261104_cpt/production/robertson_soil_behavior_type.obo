[Term]
id: SBT:0000001
name: soil behavior type
namespace: sbt.ontology
def: "Soil behavior type (SBT): classification of soil from its mechanical response in a cone penetration test (CPT), as defined by published charts. The values are the zones of a named chart, not direct grain-size measurements." []
is_a: SBT:0000000 ! term
is_a: ME:0000001

[Term]
id: SBT:0000002
name: soil behavior type classification
namespace: sbt.ontology
property_value: data_type "oterm_ref" xsd:string
property_value: is_microtype "true" xsd:boolean
property_value: is_valid_data_variable "true" xsd:boolean
property_value: is_valid_dimension "true" xsd:boolean
property_value: is_valid_dimension_variable "true" xsd:boolean
property_value: is_valid_property "true" xsd:boolean
def: "Soil behavior type assigned to a CPT reading or depth interval; the value is a zone term of one of the Robertson charts below." []
xref: ORef:SBT:0000002
is_a: SBT:0000001 ! soil behavior type

[Term]
id: SBT:0000010
name: Robertson 1986 soil behavior type
namespace: sbt.ontology
def: "Twelve-zone soil behavior type chart of Robertson, Campanella, Gillespie and Greig (1986), based on cone tip resistance and friction ratio; zone 0 is used by CPT software for readings outside the chart." []
is_a: SBT:0000002 ! soil behavior type classification

