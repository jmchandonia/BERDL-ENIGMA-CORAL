[Term]
id: GEOCHIP:0000000
name: term
namespace: geochip.ontology
def: "Root of the GeoChip functional gene category ontology." []

[Term]
id: GEOCHIP:0000001
name: GeoChip functional gene category
namespace: geochip.ontology
def: "Functional classification of the genes targeted by GeoChip probes: a category (e.g. Carbon Cycling), a subcategory (e.g. Carbon degradation) and, where the array designers gave one, a finer subcategory (e.g. Cellulose). Source: GeoChip 5.0 180K functional gene array probe classification (Institute for Environmental Genomics, University of Oklahoma; Zhou Lab), as given in the probe annotation of the ENIGMA 2017 Pilot Core GeoChip data file Pilot.core.GeoChip.T5S2.log.RA.csv." []
is_a: GEOCHIP:0000000 ! term
is_a: ME:0000001

[Term]
id: GEOCHIP:0000002
name: GeoChip gene category
namespace: geochip.ontology
property_value: data_type "oterm_ref" xsd:string
