property_value: is_valid_data_variable "true" xsd:boolean
property_value: is_valid_dimension "true" xsd:boolean
property_value: is_valid_dimension_variable "true" xsd:boolean
property_value: is_valid_property "true" xsd:boolean
def: "GeoChip functional gene category assigned to a probe or gene; the value is the deepest category term the array designers gave." []
